# Copy to .env.local and fill with values from https://dashboard.clerk.com and https://supabase.com/dashboard

# --- Clerk (https://dashboard.clerk.com → API Keys) ---
# Publishable key (safe in the browser). MUST be copied from YOUR app in Clerk Dashboard → API Keys.
# Do not use random pk_test_ strings: Clerk returns {"code":"host_invalid"} if the key does not match your instance.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Secret key (server only; never expose to the client). MUST be the Secret key from the SAME Clerk application as the publishable key above.
CLERK_SECRET_KEY=

# App URLs (match your Next.js routes)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: service role JWT (legacy) OR new sb_secret_* key — required for dashboard server code + /api/check-monitors
SUPABASE_SERVICE_ROLE_KEY=
# If you only have the new Supabase secret key name:
# SUPABASE_SECRET_KEY=

# Server-only: required for external cron (e.g. cron-job.org). POST /api/check-monitors must send header x-cron-secret: <same value>
CRON_SECRET=

# --- Resend (https://resend.com — alert emails from monitor checks) ---
# API key (server only). Without it, down/recovery HTML emails are skipped (Discord still works).
RESEND_API_KEY=
# Verified domain in Resend (Domains). You can use either form:
#   RESEND_FROM=alerts@yourdomain.com
#   RESEND_FROM=NetPulse <alerts@yourdomain.com>
# Bare emails are sent as "NetPulse <...>" automatically.
# If unset, NetPulse uses NetPulse <onboarding@resend.dev> (test sender; recipient rules apply).
RESEND_FROM=

# --- Site URL (metadata, sitemap, Open Graph; optional on Vercel — VERCEL_URL is used as fallback) ---
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- API CORS: comma-separated origins allowed to call browser-facing API routes (optional; defaults to NEXT_PUBLIC_SITE_URL only) ---
# NETPULSE_API_ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com
